{
  "name": "hyde-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/sdk", "apps/decomposer"],
  "exports": {
    "./sdk": {
      "types": "./packages/sdk/dist/types/sdk.d.ts",
      "import": "./packages/sdk/dist/hyde-sdk.mjs"
    }
  },
  "bin": {
    "hyde": "./dist/cli/hyde.mjs",
    "hyde-decompose": "./apps/decomposer/dist/cli/hyde-decompose.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --config vite.portable.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cli:build": "vite build --config vite.cli.config.ts && vite build --config vite.cli-browser.config.ts && vite build --config vite.portable.config.ts",
    "sdk:build": "vite build --config vite.sdk.config.ts && tsc --project tsconfig.sdk.json",
    "decomposer:build": "npm run cli:build && vite build --config vite.decomposer.config.ts && vite build --config vite.decomposer-cli.config.ts",
    "test:sdk": "vitest run src/authoring.node.test.ts src/sdk.acceptance.node.test.ts src/sdk.node.test.ts src/sdkSchema.node.test.ts src/cli.node.test.ts",
    "test:decomposer": "vitest run src/decomposer src/decomposerCli.node.test.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "latest",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@xmldom/xmldom": "^0.8.15",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "idb": "^8.0.3",
    "lucide-react": "latest",
    "mediabunny": "^1.61.6",
    "pixi.js": "^8.0.0",
    "playwright": "1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "fake-indexeddb": "6.2.6",
    "jsdom": "latest",
    "typescript": "~5.9.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
